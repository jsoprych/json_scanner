# Copy to .env and fill in. Sourced by run.sh (app config) and used by
# docker-compose.yml (deploy). .env is git-ignored.

# --- app config (read directly by the scanner; run.sh sources this) ---
# The cetus warehouse the scanner opens (absolute path recommended). Overrides the
# compiled-in default. This is the shared env every cetus consumer honors.
CETUS_DB=/home/john/CODE/DEV/DATA/CETUS/cetus.db
# Optional overrides:
# SCANNER_SERVE_ADDR=:8080
# SCANNER_UNIVERSE=index:r3000
# SCANNER_AUTH_MODE=login
# SCANNER_DB_LOG_LEVEL=all        # all (default) | slow (>5ms) | error | off

# --- docker-compose only ---
# Host path to the warehouse, mounted read-only into the container.
CETUS_DB_PATH=/home/john/CODE/DEV/DATA/CETUS/cetus.db

# Cloudflare tunnel token (Zero Trust → Networks → Tunnels → your tunnel → token).
CF_TUNNEL_TOKEN=

# Cloudflare Access (Zero Trust → Access → Applications → your app):
CF_TEAM=yourteam                 # <team>.cloudflareaccess.com
CF_ACCESS_AUD=                   # the Application Audience (AUD) tag
